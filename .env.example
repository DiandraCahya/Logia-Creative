# Domain Publik Website
NEXT_PUBLIC_SITE_URL=https://logia.chyas.my.id

# Logia Creative CMS API Backend (ganti dengan subdomain API production Anda, misal https://api-logia.chyas.my.id/api)
NEXT_PUBLIC_API_URL=https://api-logia.chyas.my.id/api

# Email tujuan inquiry form kolaborasi
COLLABORATION_TO=logiacreative.id@gmail.com

# Alamat pengirim (domain terverifikasi di Resend; untuk dev pakai onboarding@resend.dev)
COLLABORATION_FROM=onboarding@resend.dev

# API key Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Alamat pengirim default untuk API route (domain terverifikasi; dev: onboarding@resend.dev)
RESEND_FROM=onboarding@resend.dev

# Groq API key (server-only, jangan gunakan prefix NEXT_PUBLIC_)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# Model Groq
GROQ_MODEL=openai/gpt-oss-20b

# Telegram: struk inquiry diteruskan ke grup agensi
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-1001234567890
