# Email tujuan inquiry form kolaborasi
COLLABORATION_TO=logiacreative.id@gmail.com
# Alamat pengirim (domain terverifikasi di Resend; untuk dev pakai onboarding@resend.dev)
COLLABORATION_FROM=onboarding@resend.dev
# API key Resend (https://resend.com/api-keys) — jangan commit nilai aslinya
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Alamat pengirim default untuk API route (domain terverifikasi; dev: onboarding@resend.dev)
RESEND_FROM=onboarding@resend.dev
# Groq API key (server-only, JANGAN pakai prefix NEXT_PUBLIC_)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
# Model Groq (cek daftar terkini; default di bawah)
GROQ_MODEL=openai/gpt-oss-20b
# Telegram: struk diteruskan ke grup agensi (jangan commit nilai aslinya)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-1001234567890

# CMS Configuration
# Driver penyimpanan: 'local' (development/self-host) atau 'github' (produksi Vercel)
CMS_STORE_DRIVER=local

# GitHub Store Driver (wajib diisi jika CMS_STORE_DRIVER=github di Vercel)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=DiandraCahya
GITHUB_REPO=Logia-Creative
GITHUB_BRANCH=main

# CMS Auth
# Password admin dalam format scrypt hash (buat pakai `npm run cms:hash`)
ADMIN_PASSWORD_HASH=
# Secret HMAC untuk menandatangani cookie session admin (minimal 32 karakter acak)
SESSION_SECRET=
