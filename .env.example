COLLABORATION_TO=nextkokknock@gmail.com
# Alamat pengirim (domain terverifikasi di Resend; untuk dev pakai onboarding@resend.dev)
COLLABORATION_FROM=onboarding@resend.dev
# API key Resend (https://resend.com/api-keys) — jangan commit nilai aslinya
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Alamat pengirim default untuk API route (domain terverifikasi; dev: onboarding@resend.dev)
RESEND_FROM=onboarding@resend.dev
# Groq API key (server-only, JANGAN pakai prefix NEXT_PUBLIC_)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
# Model Groq (cek daftar terkini; default di bawah)
GROQ_MODEL=llama-3.3-70b-versatile
